{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mousetrail-themes/schema/theme.schema.json",
  "title": "MouseTrail Theme Document",
  "description": "Schema for a MouseTrail ThemeFile.Document as read by the app: a version marker plus a non-empty list of themes.",
  "type": "object",
  "required": ["version", "themes"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/theme" }
    }
  },
  "$defs": {
    "unitNumber": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "theme": {
      "type": "object",
      "required": ["name", "style"],
      "properties": {
        "name": { "type": "string" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "style": {
      "type": "object",
      "required": ["colorMode", "lifetime", "widthScale"],
      "properties": {
        "colorMode": { "$ref": "#/$defs/colorMode" },
        "lifetime": { "type": "number" },
        "widthScale": { "type": "number" }
      }
    },
    "colorMode": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "oneOf": [
        {
          "required": ["rainbow"],
          "properties": {
            "rainbow": {
              "type": "object"
            }
          }
        },
        {
          "required": ["fixed"],
          "properties": {
            "fixed": { "$ref": "#/$defs/fixedColor" }
          }
        },
        {
          "required": ["gradient"],
          "properties": {
            "gradient": { "$ref": "#/$defs/gradient" }
          }
        }
      ]
    },
    "fixedColor": {
      "type": "object",
      "required": ["red", "green", "blue", "alpha"],
      "properties": {
        "red": { "$ref": "#/$defs/unitNumber" },
        "green": { "$ref": "#/$defs/unitNumber" },
        "blue": { "$ref": "#/$defs/unitNumber" },
        "alpha": { "$ref": "#/$defs/unitNumber" }
      }
    },
    "gradient": {
      "type": "object",
      "required": ["stops"],
      "properties": {
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/gradientStop" }
        }
      }
    },
    "gradientStop": {
      "type": "object",
      "required": ["red", "green", "blue", "alpha", "location"],
      "properties": {
        "red": { "$ref": "#/$defs/unitNumber" },
        "green": { "$ref": "#/$defs/unitNumber" },
        "blue": { "$ref": "#/$defs/unitNumber" },
        "alpha": { "$ref": "#/$defs/unitNumber" },
        "location": { "$ref": "#/$defs/unitNumber" }
      }
    }
  }
}
